    {
      "name": "server-fault",
      "status": 503,
      "headers": {},
      "body": {
        "rc": "UNAVAILABLE"
      },
      "expect": {
        "kind": "server_error",
        "retryable": true,
        "message": "UNAVAILABLE"
      }
