      },
      "expect": {
        "kind": "forbidden",
        "retryable": false,
        "message": "LICENSE_EXPIRED"
      }
    },
    {
      "name": "unknown-dataset",
      "status": 404,
      "headers": {},
      "body": {
        "rc": "NOT_FOUND"
