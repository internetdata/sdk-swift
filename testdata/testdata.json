        "kind": "bad_request",
        "retryable": false,
        "message": "DB_NOT_FOUND"
      }
    },
    {
      "name": "format-not-built",
      "status": 400,
      "headers": {},
      "body": {
        "rc": "INVALID_FORMAT"
      },
      "expect": {
        "kind": "bad_request",
        "retryable": false,
        "message": "INVALID_FORMAT"
      }
    },
    {
      "name": "rate-limited-transient",
      "status": 429,
      "headers": {
